---
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectProjectTags, loadProjects, slugifyTag, splitProjects } from '../../lib/projects';

const projects = await loadProjects();
const sections = splitProjects(projects);
const currentTagSet = new Set(collectProjectTags(sections.current));
const currentTags = Array.from(currentTagSet);
const tags = collectProjectTags(projects).map((tag) => ({
  label: tag,
  slug: slugifyTag(tag),
  current: currentTagSet.has(tag)
}));
---
<BaseLayout title="Projects | Kıvanç Tatar" description="Current projects, archival highlights, and archive projects filtered by tag.">
  <div class="projects-page">
    <input class="filter-toggle" type="radio" name="project-filter" id="filter-all" checked aria-hidden="true" />
    {tags.map((tag) => (
      <input class="filter-toggle" type="radio" name="project-filter" id={`filter-${tag.slug}`} aria-hidden="true" />
    ))}

    <section class="hero" style="padding-bottom: 1.5rem;">
      <div class="hero-panel prose project-hero-panel">
        <h1>Projects</h1>
        <div class="filter-row project-filter-row" data-tag-filter>
          <label class="filter-chip" for="filter-all">All</label>
          {tags.map((tag) => (
            <label class={`filter-chip${tag.current ? ' current-tag-highlight' : ''}`} for={`filter-${tag.slug}`}>
              {tag.label}
            </label>
          ))}
        </div>
      </div>
    </section>

    <div class="project-sections">
    <section class="section" data-project-section="current">
      <div class="section-header">
        <h2 class="section-heading">Current projects</h2>
      </div>
      <div class="project-grid" data-project-grid>
        {sections.current.map((project) => <ProjectCard project={project} currentTags={currentTags} />)}
      </div>
      <p class="empty-state" hidden data-empty-state="current">No current projects match this tag.</p>
    </section>

    <section class="section" data-project-section="highlights">
      <div class="section-header">
        <h2 class="section-heading">Archival Highlights</h2>
      </div>
      <div class="project-grid" data-project-grid>
        {sections.highlights.map((project) => <ProjectCard project={project} currentTags={currentTags} />)}
      </div>
      <p class="empty-state" hidden data-empty-state="highlights">No archival highlights match this tag.</p>
    </section>

    <section class="section" data-project-section="archive">
      <div class="section-header">
        <h2 class="section-heading">Archive</h2>
      </div>
      <div class="project-grid" data-project-grid>
        {sections.archive.map((project) => <ProjectCard project={project} currentTags={currentTags} />)}
      </div>
      <p class="empty-state" hidden data-empty-state="archive">No archive projects match this tag.</p>
    </section>
  </div>
  </div>

  <style is:global>
    .project-hero-panel {
      max-width: none;
    }

    .project-filter-row {
      margin-top: 1rem;
    }

    .project-filter-row .filter-chip {
      color: var(--text);
    }

    .project-sections .section-heading {
      color: var(--very-muted);
    }

    .filter-toggle {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .filter-toggle:checked + .filter-chip {
      background: var(--accent-yellow);
      color: #111111;
      border-color: var(--border-strong);
      box-shadow: 3px 3px 0 var(--accent-yellow);
    }

    .card {
      overflow: hidden;
      opacity: 1;
      transform: translateY(0) scale(1);
      transform-origin: top center;
      transition:
        opacity 560ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
      will-change: opacity, transform;
    }

    .card.is-collapsed {
      display: none;
    }

    .project-grid {
      position: relative;
    }

    .card.is-floating-out {
      position: absolute;
      z-index: 2;
      pointer-events: none;
      opacity: 0;
      transform: translateY(0.55rem) scale(0.988);
      margin: 0;
      will-change: opacity, transform;
    }

    .card.is-entering {
      display: grid;
      opacity: 0;
      transform: translateY(0.55rem) scale(0.988);
    }
  </style>

  <script is:inline>
    function setupProjectFilters() {
      const filterInputs = Array.from(document.querySelectorAll('input[name="project-filter"]'));
      const filterChips = Array.from(document.querySelectorAll('.filter-chip'));
      const cards = Array.from(document.querySelectorAll('[data-project-section] .card'));
      const searchParams = new URLSearchParams(window.location.search);
      const initialTag = searchParams.get('tag') || 'all';

      function getActiveTag() {
        const checkedInput = filterInputs.find((input) => input.checked);
        return checkedInput?.id === 'filter-all' ? 'all' : checkedInput?.id.replace('filter-', '') || 'all';
      }

      function setInitialFilter() {
        const matchingInput = initialTag === 'all' ? document.querySelector('#filter-all') : document.querySelector(`#filter-${initialTag}`);
        if (matchingInput instanceof HTMLInputElement) {
          matchingInput.checked = true;
        }
      }

      function matchesTag(card, activeTag) {
        if (activeTag === 'all') {
          return true;
        }

        return (card.classList.contains(`tag-${activeTag}`));
      }

      function clearInlinePosition(card) {
        card.style.left = '';
        card.style.top = '';
        card.style.width = '';
        card.style.height = '';
        card.style.margin = '';
        card.style.zIndex = '';
        card.style.position = '';
      }

      function setFloatingPosition(card) {
        const grid = card.closest('[data-project-grid]');
        if (!(grid instanceof HTMLElement)) {
          return;
        }

        const cardRect = card.getBoundingClientRect();
        const gridRect = grid.getBoundingClientRect();
        card.style.left = `${cardRect.left - gridRect.left}px`;
        card.style.top = `${cardRect.top - gridRect.top}px`;
        card.style.width = `${cardRect.width}px`;
        card.style.height = `${cardRect.height}px`;
      }

      function showCard(card) {
        if (card.classList.contains('is-collapsed')) {
          card.classList.remove('is-collapsed');
          card.classList.add('is-entering');
          requestAnimationFrame(() => {
            card.classList.remove('is-entering');
          });
        }
      }

      function hideCard(card) {
        if (card.classList.contains('is-collapsed') || card.classList.contains('is-floating-out')) {
          return;
        }

        setFloatingPosition(card);
        card.classList.add('is-floating-out');

        const finishCollapse = (event) => {
          if (event.propertyName !== 'opacity') {
            return;
          }

          card.classList.remove('is-floating-out');
          card.classList.add('is-collapsed');
          clearInlinePosition(card);
          card.removeEventListener('transitionend', finishCollapse);
        };

        card.addEventListener('transitionend', finishCollapse);
      }

      function applyFilter() {
        const activeTag = getActiveTag();
        const beforeRects = new Map();

        filterChips.forEach((chip) => {
          if (!(chip instanceof HTMLLabelElement)) {
            return;
          }

          chip.setAttribute('aria-pressed', chip.htmlFor === `filter-${activeTag}` ? 'true' : 'false');
        });

        cards.forEach((card) => {
          const shouldShow = matchesTag(card, activeTag);
          if (shouldShow && !card.classList.contains('is-collapsed') && !card.classList.contains('is-floating-out')) {
            beforeRects.set(card, card.getBoundingClientRect());
          }

          if (shouldShow) {
            showCard(card);
          } else {
            hideCard(card);
          }
        });

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            Array.from(beforeRects.entries()).forEach(([card, beforeRect], index) => {
              const afterRect = card.getBoundingClientRect();
              const deltaX = beforeRect.left - afterRect.left;
              const deltaY = beforeRect.top - afterRect.top;

              if (deltaX === 0 && deltaY === 0) {
                return;
              }

              const previousTransition = card.style.transition;
              const staggerDelay = Math.min(index * 18, 120);
              card.style.transition = `transform 560ms cubic-bezier(0.22, 1, 0.36, 1) ${staggerDelay}ms`;
              card.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
              card.getBoundingClientRect();

              requestAnimationFrame(() => {
                card.style.transform = '';
                const finishMove = (event) => {
                  if (event.propertyName !== 'transform') {
                    return;
                  }

                  card.style.transition = previousTransition;
                  card.removeEventListener('transitionend', finishMove);
                };

                card.addEventListener('transitionend', finishMove);
              });
            });
          });
        });
      }

      filterInputs.forEach((input) => {
        input.addEventListener('change', applyFilter);
      });

      setInitialFilter();
      applyFilter();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupProjectFilters, { once: true });
    } else {
      setupProjectFilters();
    }
  </script>
</BaseLayout>
