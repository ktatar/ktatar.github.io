---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPublicationCitationAcm, groupPublicationsByYear, loadPublications } from '../../lib/publications';

const publications = loadPublications();
const groups = groupPublicationsByYear(publications);
---
<BaseLayout title="Publications | Kıvanç Tatar" description="Publications rendered from a BibTeX source file.">
  <section class="hero" style="padding-bottom: 1.5rem;">
    <div class="hero-panel prose publications-hero-panel">
      <h1>Publications</h1>
    </div>
  </section>

  <div class="publication-list">
    {groups.map((group) => (
      <section class="section publication-group">
        <h2 class="section-heading">{group.label}</h2>
        <div class="publication-list">
          {group.items.map((publication) => (
            <article class="publication-item">
              <p class="publication-title home-publication-title">
                {publication.url ? (
                  <a href={publication.url} target="_blank" rel="noreferrer">
                    {publication.title}
                  </a>
                ) : (
                  publication.title
                )}
                {publication.url && (
                  <a
                    class="publication-link-icon"
                    href={publication.url}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`Link to ${publication.title}`}
                  >
                    <i class="fa-solid fa-link"></i>
                  </a>
                )}
              </p>
              <p class="publication-citation" set:html={formatPublicationCitationAcm(publication)} />
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style is:global>
  .publications-hero-panel {
    max-width: none;
  }

  .publication-group .section-heading {
    color: var(--very-muted);
  }
</style>
